# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for HMAC token signing and user sessions.
# Wajib disetel saat production agar otorisasi aman.
SESSION_SECRET="ganti-dengan-kunci-rahasia-random-minimal-32-karakter"

# MAX_FILE_SIZE_MB: Batas maksimal per file yang diunggah ke workspace (dalam megabyte).
# Default: 200
MAX_FILE_SIZE_MB="200"

# PORT: Server HTTP port (default 3000)
PORT="3000"
